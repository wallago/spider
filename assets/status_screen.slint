import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

export component StatusScreen inherits Window {
    width: 240px;
    height: 320px;
    background: #0B1020;
    default-font-family: "Inter";

    // Strings, not numbers, so the firmware formats and the UI just renders —
    // same contract as CreditScreen.
    in property <string> header: "System";
    in property <string> temperature: "41";
    in property <string> uptime: "02:14:37";
    in property <string> heap: "312 KB";
    in property <bool> online: true;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #0B1020;

        VerticalBox {
            spacing: 12px;
            padding: 16px;

            // Header
            HorizontalBox {
                alignment: center;

                Text {
                    text: root.header;
                    color: white;
                    font-size: 22px;
                    font-weight: 700;
                }

                Rectangle {
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: root.online ? #FFB020 : #666;
                }
            }

            Rectangle {
                height: 20px;
            }

            // Main reading. Amber where CreditScreen is green, so which panel
            // is which is obvious at a glance during bring-up.
            HorizontalBox {
                alignment: center;

                Text {
                    text: root.temperature;
                    color: white;
                    font-size: 72px;
                    font-weight: 800;
                }

                Text {
                    text: "°C";
                    color: #FFB020;
                    font-size: 36px;
                    font-weight: 700;
                }
            }

            Text {
                text: "DIE TEMP";
                horizontal-alignment: center;
                color: #7E8AA8;
                font-size: 18px;
                letter-spacing: 3px;
            }

            Rectangle {
                height: 24px;
            }

            HorizontalBox {
                Text {
                    text: "UPTIME";
                    color: #7E8AA8;
                    font-size: 16px;
                }

                Text {
                    text: root.uptime;
                    color: white;
                    font-size: 16px;
                    horizontal-alignment: right;
                }
            }

            HorizontalBox {
                Text {
                    text: "HEAP";
                    color: #7E8AA8;
                    font-size: 16px;
                }

                Text {
                    text: root.heap;
                    color: white;
                    font-size: 16px;
                    horizontal-alignment: right;
                }
            }
        }
    }
}
