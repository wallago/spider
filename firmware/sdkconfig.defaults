# The board has ESP32-P4 revision v1.3. v1.x and v3.x images are not
# interchangeable, so this build — bootloader included — targets v1.x only.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# Rust needs more main-task stack than the 3.5 KB ESP-IDF default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000
